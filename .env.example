# ============================================================
# SK JURÍDICO — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# ============================================================

# ── Banco de Dados ───────────────────────────────────────────
# PostgreSQL (Neon, Supabase, Railway, local, etc.)
# Formato: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ── Sessão ───────────────────────────────────────────────────
# String aleatória longa para assinar cookies de sessão (mín. 32 chars)
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria-aqui

# ── Servidor ─────────────────────────────────────────────────
PORT=8080
BASE_PATH=/
NODE_ENV=production

# ── Senha de acesso ao app (opcional) ────────────────────────
# Se definida, o app exigirá essa senha para entrar.
APP_PASSWORD=

# ── Chaves de IA (salvas também pelo painel de configurações) ─
# Gemini (Google AI Studio): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Groq: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Perplexity: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# xAI / Grok: https://console.x.ai/
XAI_API_KEY=xai-...

# Chave/URL/Modelo personalizado (qualquer API OpenAI-compatível)
CUSTOM_API_KEY=
CUSTOM_API_URL=https://api.openai.com/v1
CUSTOM_API_MODEL=gpt-4o-mini

# ── DataJud CNJ ───────────────────────────────────────────────
# Chave para acesso à API pública do CNJ DataJud
DATAJUD_API_KEY=

# ── TTS / Voz ────────────────────────────────────────────────
# Velocidade (1.0 = normal, 0.8 = lenta, 1.3 = rápida)
TTS_SPEED=1.0
# Voz padrão do Web Speech API (ex: pt-BR, Google português)
TTS_VOICE=pt-BR

# ── Upload ────────────────────────────────────────────────────
# Tamanho máximo de arquivo em MB (padrão: 150)
UPLOAD_MAX_MB=150
